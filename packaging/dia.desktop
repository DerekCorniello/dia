[Desktop Entry]
Type=Application
Name=dia
Comment=Cross-platform launcher for dev workspaces
# WEBKIT_DISABLE_DMABUF_RENDERER works around a WebKitGTK explicit-sync
# crash ("Missing acquire timeline") on NVIDIA + Wayland that kills the
# window milliseconds after launch. Absolute /usr/bin/env because some
# launchers do not do PATH lookup on the Exec command itself.
Exec=/usr/bin/env WEBKIT_DISABLE_DMABUF_RENDERER=1 @EXEC@
Icon=@ICON@
Terminal=false
Categories=Development;Utility;
Keywords=workspace;launcher;dev;developer;environment;
StartupNotify=false
StartupWMClass=dia